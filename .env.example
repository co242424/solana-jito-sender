# Solana RPC (Helius, Triton, public, etc.)
RPC_URL=https://api.mainnet-beta.solana.com

# Path to a local Solana keypair: JSON byte array (solana-keygen) or base58 secret.
# Never commit this file or paste the secret into chat / Discord.
KEYPAIR_PATH=./id.json

# Jito Block Engine — Tokyo is the default (docs.jito.wtf low-latency send)
BLOCK_ENGINE_URL=https://tokyo.mainnet.block-engine.jito.wtf

# Optional UUID from a Jito Discord whitelist ticket.
# Leave empty to use the default 1 rps per IP limit.
# Auth: x-jito-auth header and/or ?uuid= query param.
JITO_UUID=
